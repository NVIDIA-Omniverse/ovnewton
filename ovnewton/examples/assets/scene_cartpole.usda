(
    customLayerData = {
        dictionary renderSettings = {
        }
    }
    defaultPrim = "cartPole"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)

# An articulated demo: a cart on a sliding rail
# carrying a two-link inverted pendulum (1 prismatic + 2 revolute joints, fixed
# base). Under gravity with no controller the poles topple and swing — a clearly
# articulated, in-frame motion. The joint definitions and body mass properties
# are retained from Newton's cartpole asset (known-good against add_usd). The
# articulation schema, initial pole poses, colors, lighting, and render setup
# are adapted for ovnewton and ovrtx.

def PhysicsScene "physicsScene"
{
    float3 gravity = (0, 0, -9.81)
}

def Xform "cartPole" (
    prepend apiSchemas = ["NewtonArticulationRootAPI"]
)
{
    bool newton:selfCollisionEnabled = 0

    def Xform "rail" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        def Cube "rail" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (0.03, 8, 0.03)
            uniform token[] xformOpOrder = ["xformOp:scale"]
            color3f[] primvars:displayColor = [(0.9, 0.6, 0.2)]
        }
    }

    def Xform "cart" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float3 xformOp:translate = (0, 0, 0)
        float3 xformOp:scale = (0.2, 0.25, 0.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

        float3 physics:diagonalInertia = (0.0085, 0.0067, 0.0085)
        float physics:mass = 1
        quatf physics:principalAxes = (1, 0, 0, 0)

        def Cube "cart" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.3, 0.5, 0.7)]
        }
    }

    def Xform "pole1" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        # Start leaning 25 deg off-vertical (rotated about the cart pivot so the
        # joint anchor stays put) so the inverted pendulum topples instead of
        # sitting in its unstable equilibrium.
        float3 xformOp:translate = (0.11, -0.21131, 0.45315)
        quatf xformOp:orient = (0.9763, 0.21644, 0, 0)
        float3 xformOp:scale = (0.04, 0.06, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        float3 physics:diagonalInertia = (0.0209, 0.0209, 0.0001)
        float physics:mass = 0.25
        quatf physics:principalAxes = (1, 0, 0, 0)
        point3f physics:centerOfMass = (0, 0, 0)

        def Cube "pole1" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.85, 0.25, 0.2)]
        }
    }

    def Xform "pole2" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float3 xformOp:translate = (0.11, -0.63393, 1.35946)
        quatf xformOp:orient = (0.9763, 0.21644, 0, 0)
        float3 xformOp:scale = (0.04, 0.06, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        float3 physics:diagonalInertia = (0.0209, 0.0209, 0.0001)
        float physics:mass = 0.25
        quatf physics:principalAxes = (1, 0, 0, 0)
        point3f physics:centerOfMass = (0, 0, 0)

        def Cube "pole2" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.95, 0.55, 0.15)]
        }
    }
    # fixed base
    def PhysicsFixedJoint "rootJoint"
    {
        rel physics:body1 = </cartPole/rail>
    }

    def PhysicsPrismaticJoint "railCartJoint"
    {
        rel physics:body0 = </cartPole/rail>
        rel physics:body1 = </cartPole/cart>
        uniform token physics:axis = "Y"
        float physics:lowerLimit = -4
        float physics:upperLimit = 4
    }

    def PhysicsRevoluteJoint "cartPoleJoint"
    {
        rel physics:body0 = </cartPole/cart>
        rel physics:body1 = </cartPole/pole1>
        uniform token physics:axis = "X"
        point3f physics:localPos0 = (0.55, 0.0, 0)
        point3f physics:localPos1 = (0, 0, -0.5)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
    }

    def PhysicsRevoluteJoint "polePoleJoint"
    {
        rel physics:body0 = </cartPole/pole1>
        rel physics:body1 = </cartPole/pole2>
        uniform token physics:axis = "X"
        point3f physics:localPos0 = (0, 0, 0.5)
        point3f physics:localPos1 = (0, 0, -0.5)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
    }
}

# ── Render scaffolding (ovrtx) ────────────────────────────────────────
# Side view looking down -X: the revolute axis is X and the rail is along Y, so
# all motion lives in the Y-Z plane. Orienting the camera down -X puts Y across
# the screen (rail + cart slide) and Z up (pole swing) — the natural 2D view of
# a cartpole. orient (w,x,y,z)=(.5,.5,.5,.5) cyclically maps cam +X->world +Y
# (screen right), cam +Y->world +Z (up), cam -Z (look) -> world -X.

def DomeLight "DomeLight"
{
    float inputs:exposure = 0
    float inputs:intensity = 100
    token inputs:texture:format = "latlong"
}

def DistantLight "Sun"
{
    float inputs:intensity = 600
    float inputs:angle = 0.53
    quatd xformOp:orient = (0.92388, 0.38268, 0, 0)
    token[] xformOpOrder = ["xformOp:orient"]
}

def Camera "Camera" (
    prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
)
{
    float2 clippingRange = (1, 10000000)
    float exposure = 0
    float focalLength = 0.4
    float focusDistance = 11.0
    float horizontalAperture = 0.36
    token projection = "perspective"
    float verticalAperture = 0.2025
    double3 xformOp:translate = (11, 0, 0.7)
    quatd xformOp:orient = (0.5, 0.5, 0.5, 0.5)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
}

def "Render"
{
    def RenderProduct "Camera"
    {
        rel camera = </Camera>
        rel orderedVars = </Render/Camera/LdrColor>
        int2 resolution = (1280, 720)

        def RenderVar "LdrColor"
        {
            string sourceName = "LdrColor"
        }
    }
}
